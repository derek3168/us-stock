      "maxDuration": 60
    },
    "src/app/api/scan/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/scan/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cache/route.ts": {
      "maxDuration": 30
